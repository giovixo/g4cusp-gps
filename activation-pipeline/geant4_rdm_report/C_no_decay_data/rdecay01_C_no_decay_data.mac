# Report C: unstable levels without decay data are killed without emitting anything
# Run with the unmodified example
#   examples/extended/radioactivedecay/rdecay01
# and read the "Nb of generated particles" table of each run.
/control/verbose 2
/run/verbose 0
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year
/run/initialize
/gun/particle ion
/rdecay01/fullChain false
/run/printProgress 0
#
# Control (correct data)
/gun/ion 27 57
/run/beamOn 20000
#
# Levels without decay data
/gun/ion 73 178 0 0 X
/run/beamOn 20000
/gun/ion 96 252
/run/beamOn 20000
/gun/ion 83 198
/run/beamOn 20000
