# Report A: Q <= 0 in the detail lines, no beta particle emitted
# Run with the unmodified example
#   examples/extended/radioactivedecay/rdecay01
# and read the "Nb of generated particles" table of each run.
/control/verbose 2
/run/verbose 0
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year
/run/initialize
/gun/particle ion
/rdecay01/fullChain false
/run/printProgress 0
#
# Controls (correct data): every decay emits e- + anti_nu_e, or nu_e
/gun/ion 39 90
/run/beamOn 20000
/gun/ion 43 99
/run/beamOn 20000
/gun/ion 27 57
/run/beamOn 20000
#
# Q <= 0: no e- (Mo99, Ru103, I132) or no e+ (Y88)
/gun/ion 42 99
/run/beamOn 20000
/gun/ion 44 103
/run/beamOn 20000
/gun/ion 53 132
/run/beamOn 20000
/gun/ion 39 88
/run/beamOn 20000
#
# Ir194[190X]: Q = -20.14 keV in the 97% branch (corrected in 5.1.1, back in 6.x)
/gun/ion 77 194 0 190 X
/run/beamOn 20000
